  "concurrenceRules": [
    {
      "code": "RULE_CENTRAL_MERIT_MUTUAL_EXCLUSION",
      "description": "NSP permits submitting only 1 Central Merit application per academic cycle.",
      "relationship": "MUTUALLY_EXCLUSIVE",
      "appliesToClassifications": ["CENTRAL_MERIT", "CENTRAL_MERIT"],
      "warningMessage": "You cannot submit more than one Central Merit application on NSP in the same academic year."
    },
    {
      "code": "RULE_CENTRAL_DISBURSEMENT_DUPLICATION",
      "description": "DBT Bharat and GFR 230(1) prohibit receiving duplicate central disbursements.",
      "relationship": "DUAL_APPLY_SINGLE_DISBURSE",
      "appliesToClassifications": ["CENTRAL_MERIT", "CENTRAL_WELFARE"],
      "warningMessage": "NSP permits applying to both 1 Merit and 1 Welfare scheme to maximize your selection odds. However, if awarded both, you must surrender one before final disbursement."
    },
    {
      "code": "RULE_STATE_TUITION_DISPLACEMENT",
      "description": "State Post-Matric fee reimbursement is displaced if a central scheme pays full tuition.",
      "relationship": "MUTUALLY_EXCLUSIVE",
      "appliesToClassifications": ["CENTRAL_WELFARE", "STATE_POST_MATRIC"],
      "warningMessage": "Both schemes reimburse tuition fees. Claiming tuition from both State and Central sources is prohibited."
    },
