# ScholarBridge Environment Variables
# Copy to .env.local and fill in your Supabase project values

# Public - safe for client bundle
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-jwt>"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only - NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY="<server-only-service-role-jwt>"
